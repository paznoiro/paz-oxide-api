+    /// Find an object whose xref entry is wrong: it points at another
+    /// object's header, or at a stream that isn't an object stream holding
+    /// it. Tries a standalone `N G obj` from the whole-file scan, then a copy
+    /// packed in any object stream. `None` when neither exists.
+    fn recover_misfiled_object(&self, obj_ref: ObjectRef) -> Option<Object> {
+        if let Ok(offset) = self.scan_for_object(obj_ref) {
+            match self.load_uncompressed_object_impl(obj_ref, offset, true) {
+                Ok(obj) => return Some(obj),
+                Err(e) => log::debug!(
+                    "Object {} at scanned offset {} failed to load: {}",
+                    obj_ref.id,
+                    offset,
+                    e
+                ),
+            }
+        }
+        self.recover_from_object_streams();
+        let packed = self
+            .object_cache
+            .lock_or_recover()
+            .get(&ObjectRef::new(obj_ref.id, 0))
+            .cloned();
+        packed.filter(|o| !matches!(o, Object::Null))
+    }
