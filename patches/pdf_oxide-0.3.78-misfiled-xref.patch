+/// Whether `bytes` starts with the `N G obj` header of object `obj_num`.
+fn header_names(bytes: &[u8], obj_num: u32) -> bool {
+    let mut parts = bytes.split(u8::is_ascii_whitespace).filter(|p| !p.is_empty());
+    parts.next().and_then(|n| std::str::from_utf8(n).ok()?.parse::<u32>().ok()) == Some(obj_num)
+        && parts.next().is_some_and(|g| g.iter().all(u8::is_ascii_digit))
+        && parts.next().is_some_and(|kw| kw.starts_with(b"obj"))
+}
