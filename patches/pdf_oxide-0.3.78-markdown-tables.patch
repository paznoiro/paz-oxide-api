+/// HTML-to-PDF producers often draw one horizontal border per cell, with
+/// no vertical rules. Repeated, touching border segments give exact columns
+/// and row bands; do not re-infer them from word centres or split wrapped cells.
+fn detect_segmented_rule_tables(
+    spans: &[TextSpan],
+    lines: &[crate::elements::PathContent],
+    config: &TableDetectionConfig,
+) -> Vec<Table> {
+    const SNAP: f32 = 2.0;
+    let mut pieces: Vec<_> = lines.iter()
+        .filter(|p| p.is_horizontal_line(SNAP))
+        .map(|p| p.rendered_bbox())
+        .filter(|r| r.x.is_finite() && r.y.is_finite() && r.width.is_finite()
+            && r.width > SNAP && r.height <= SNAP)
+        .collect();
+    pieces.sort_by(|a, b| crate::utils::safe_float_cmp(b.y, a.y)
+        .then_with(|| crate::utils::safe_float_cmp(a.x, b.x)));
+    let mut levels: Vec<(f32, Vec<crate::geometry::Rect>)> = Vec::new();
+    for piece in pieces {
+        if let Some((_, row)) = levels.last_mut().filter(|(y, _)| (*y - piece.y).abs() <= SNAP) {
+            row.push(piece);
+        } else {
+            levels.push((piece.y, vec![piece]));
+        }
+    }
+    let mut families: Vec<(Vec<f32>, Vec<f32>)> = Vec::new();
+    for (y, mut row) in levels {
+        row.sort_by(|a, b| crate::utils::safe_float_cmp(a.x, b.x));
+        row.dedup_by(|a, b| (a.x - b.x).abs() <= SNAP && (a.width - b.width).abs() <= SNAP);
+        let mut runs: Vec<Vec<f32>> = Vec::new();
+        for r in row {
+            if let Some(run) = runs.last_mut().filter(|v| (v[v.len() - 1] - r.x).abs() <= SNAP) {
+                run.push(r.x + r.width);
+            } else {
+                runs.push(vec![r.x, r.x + r.width]);
+            }
+        }
+        for edges in runs {
+            let cols = edges.len() - 1;
+            if cols < config.min_table_columns.max(2) || cols > config.max_table_columns
+                || edges[cols] - edges[0] < 100.0 { continue; }
+            if let Some((_, ys)) = families.iter_mut().find(|(xs, ys)| xs.len() == edges.len()
+                && xs.iter().zip(&edges).all(|(a, b)| (a - b).abs() <= SNAP)
+                // A distant table with the same columns starts a new family.
+                && ys.last().is_some_and(|last| last - y <= 72.0)) {
+                ys.push(y);
+            } else {
+                families.push((edges, vec![y]));
+            }
+        }
+    }
+    let mut tables = Vec::new();
+    for (xs, ys) in families {
+        // At least two identically segmented rules: one underline is not a grid.
+        let group = ys.as_slice();
+        if group.len() < 2 { continue; }
+        let cols = xs.len() - 1;
+        let top = group[0];
+        let bottom = *group.last().unwrap();
+        let header: Vec<_> = spans.iter().filter(|s| {
+            let c = s.bbox.center();
+            c.x >= xs[0] && c.x <= xs[cols] && c.y > top
+                && c.y - top <= s.font_size.max(1.0) * 2.0
+        }).collect();
+        let header_top = header.iter().map(|s|s.bbox.y + s.bbox.height).fold(top, f32::max);
+        let mut bands = vec![header_top + 1.0];
+        bands.extend_from_slice(group);
+        let mut table = Table::new();
+        table.col_count = cols;
+        table.has_header = true;
+        table.bbox = Some(crate::geometry::Rect::new(xs[0], bottom, xs[cols] - xs[0], header_top + 1.0 - bottom));
+        for (ri, band) in bands.windows(2).enumerate() {
+            let mut row = TableRow { cells: Vec::new(), is_header: ri == 0 };
+            for (ci, col) in xs.windows(2).enumerate() {
+                let mut cell = TableCell::new(String::new(), ri == 0);
+                cell.bbox = Some(crate::geometry::Rect::new(col[0], band[1], col[1]-col[0], band[0]-band[1]));
+                cell.spans = spans.iter().filter(|s| {
+                    let c = s.bbox.center();
+                    c.x >= col[0] && (c.x < col[1] || (ci == cols - 1 && c.x == col[1]))
+                        && c.y >= band[1] && c.y < band[0]
+                }).cloned().collect();
+                cell.spans.sort_by(|a,b| crate::utils::row_aware_span_cmp(
+                    a.bbox.y,a.bbox.x,b.bbox.y,b.bbox.x));
+                cell.text = cell.spans.iter().map(span_text_for_cell).collect::<Vec<_>>().join(" ");
+                row.cells.push(cell);
+            }
+            table.rows.push(row);
+        }
+        if table.is_real_grid() && is_valid_table(&table)
+            && table.rows.len() * cols >= config.min_table_cells {
+            tables.push(table);
+        }
+    }
+    tables
+}
