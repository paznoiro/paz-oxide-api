+    #[test]
+    fn test_slanting_line_scored_on_its_own_pixels() {
+        // A line climbing 1 px every 4 columns fills about a third of its
+        // bounding rectangle: scored over the rectangle (~0.3) it fell under
+        // a 0.6 box threshold.
+        let mut prob_map = Array2::<f32>::zeros((24, 60));
+        for x in 4..56 {
+            for y in (18 - x / 4)..(24 - x / 4) {
+                prob_map[[y, x]] = 0.95;
+            }
+        }
+        let boxes = extract_boxes(prob_map.view(), 0.3, 0.6, 100, 1.5, 1.0).unwrap();
+        assert_eq!(boxes.len(), 1);
+        assert!((boxes[0].confidence - 0.95).abs() < 1e-5, "score {}", boxes[0].confidence);
+    }
+
