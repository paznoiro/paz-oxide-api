# Bearer token for /v1/* (at least 16 characters). Generate one with:
#   openssl rand -hex 32
OXIDE_API_API_KEY=change-me-to-a-long-random-secret
# Indra is selected per request with ocr_engine=indra. Math is on by default.
OXIDE_API_INDRA_MATH=true
OXIDE_API_INDRA_MAX_CONCURRENT=1
OXIDE_API_INDRA_MODEL_DIR=/models/indra
# Bound optional include_debug=true response payloads (binary uploads excluded).
OXIDE_API_MAX_DEBUG_BYTES=1048576
