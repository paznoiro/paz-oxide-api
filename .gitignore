# --- Rust build output (also holds downloaded OCR test assets in target/ocr-assets/) ---
/target/
**/*.rs.bk
*.pdb

# --- vendored crates (regenerated by scripts/vendor_pdf_oxide.sh from patches/) ---
/vendor/

# --- secrets / local env (keep .env.example committed) ---
.env
.env.*
!.env.example
.oxide-local.env

# --- downloaded OCR models (scripts/fetch_ocr_models.sh defaults to ./models/) ---
/models/

# --- patch leftovers (patch -p1 on vendor/ failures) ---
*.orig
*.rej

# --- Python helpers (scripts/loadtest.py, scripts/fixtures/generate.py) ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- macOS / Windows ---
.DS_Store
**/.DS_Store
Thumbs.db

# --- editors / IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~
