{
  "openapi": "3.1.0",
  "info": {
    "title": "Oxide API",
    "version": "0.2.0",
    "summary": "Text and markdown extraction from PDF, Office, OpenDocument and image files, with OCR.",
    "description": "One HTTP API that extracts `text` and `markdown` from **PDF**, **Office** (DOCX, XLSX, PPTX,\nDOC, XLS, PPT), **OpenDocument** (ODT, ODS, ODP) and **image** files (PNG, JPEG, TIFF, WebP,\nGIF, BMP, JPEG 2000, PNM, TGA). The file type is detected from the content, so one route\nserves every format.\n\nPDF pages are classified one by one: pages with a usable text layer are extracted natively,\nand scanned or legacy-font pages go through OCR (English, Hindi, Arabic) in the same request.\nImages go straight to OCR, one page per TIFF page; EXIF orientation is honoured. HEIC, AVIF\nand JPEG XL are recognized but not supported.\n\n**Input.** Send the document as multipart (`file=<binary>`), as JSON\n(`{\"file_base64\": \"...\"}`), or as the raw request body. Parameters are top-level multipart\nparts, JSON keys, or query parameters; body parameters override query parameters. Parameters\nthat don't apply to the detected document kind are ignored and listed in `ignored_params`.\n\n**Output.** JSON by default. `Accept: text/plain` (text endpoint) or `Accept: text/markdown`\n(markdown endpoint) returns the raw text, with metadata in `X-Oxide-*` headers.\n\n**Limits.** 32 MiB request body (for JSON this counts the base64 text). 8 requests are\nprocessed at once per container; others wait up to 1 s for a slot, then get `429`.\nNative extraction has a 30 s deadline, requests that OCR any page 120 s, both measured from\nadmission. A PDF or image that runs out of time returns the pages done so far with\n`incomplete: true`. Images are limited to 64 megapixels per page.\n\nErrors use RFC 9457 `application/problem+json`.\n",
    "license": {
      "name": "MIT OR Apache-2.0"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "tags": [
    {
      "name": "extract",
      "description": "Text, markdown and document info"
    },
    {
      "name": "ops",
      "description": "Health, readiness, version, metrics (unauthenticated)"
    }
  ],
  "paths": {
    "/v1/extract/text": {
      "post": {
        "tags": [
          "extract"
        ],
        "operationId": "extractText",
        "summary": "Extract plain text",
        "description": "Office and OpenDocument: the document's plain text. PDF: per-page native text, with OCR\nfor pages that need it. Images: OCR text per page. Pages are joined with a blank line.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/format"
          },
          {
            "$ref": "#/components/parameters/pages"
          },
          {
            "$ref": "#/components/parameters/ocr"
          },
          {
            "$ref": "#/components/parameters/lang"
          },
          {
            "$ref": "#/components/parameters/clean"
          },
          {
            "$ref": "#/components/parameters/filename"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/Document"
        },
        "responses": {
          "200": {
            "description": "Extracted text",
            "headers": {
              "X-Engine": {
                "$ref": "#/components/headers/X-Engine"
              },
              "Server-Timing": {
                "$ref": "#/components/headers/Server-Timing"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/PdfExtraction"
                    },
                    {
                      "$ref": "#/components/schemas/OfficeExtraction"
                    },
                    {
                      "$ref": "#/components/schemas/ImageExtraction"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "kind",
                    "mapping": {
                      "pdf": "#/components/schemas/PdfExtraction",
                      "office": "#/components/schemas/OfficeExtraction",
                      "image": "#/components/schemas/ImageExtraction"
                    }
                  }
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "description": "Raw text; metadata in `X-Oxide-*` headers."
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "408": {
            "$ref": "#/components/responses/UploadTimeout"
          },
          "413": {
            "$ref": "#/components/responses/TooLarge"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          },
          "429": {
            "$ref": "#/components/responses/Busy"
          },
          "503": {
            "$ref": "#/components/responses/Draining"
          }
        }
      }
    },
    "/v1/extract/markdown": {
      "post": {
        "tags": [
          "extract"
        ],
        "operationId": "extractMarkdown",
        "summary": "Extract markdown",
        "description": "Office and OpenDocument: markdown rendering of the document structure (headings, lists,\ntables). PDF: per-page markdown with heading detection; OCR'd pages and images contribute\ntheir lines and paragraphs.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/format"
          },
          {
            "$ref": "#/components/parameters/pages"
          },
          {
            "$ref": "#/components/parameters/ocr"
          },
          {
            "$ref": "#/components/parameters/lang"
          },
          {
            "$ref": "#/components/parameters/detect_headings"
          },
          {
            "$ref": "#/components/parameters/clean"
          },
          {
            "$ref": "#/components/parameters/filename"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/Document"
        },
        "responses": {
          "200": {
            "description": "Extracted markdown",
            "headers": {
              "X-Engine": {
                "$ref": "#/components/headers/X-Engine"
              },
              "Server-Timing": {
                "$ref": "#/components/headers/Server-Timing"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/PdfExtraction"
                    },
                    {
                      "$ref": "#/components/schemas/OfficeExtraction"
                    },
                    {
                      "$ref": "#/components/schemas/ImageExtraction"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "kind",
                    "mapping": {
                      "pdf": "#/components/schemas/PdfExtraction",
                      "office": "#/components/schemas/OfficeExtraction",
                      "image": "#/components/schemas/ImageExtraction"
                    }
                  }
                }
              },
              "text/markdown": {
                "schema": {
                  "type": "string"
                },
                "description": "Raw markdown; metadata in `X-Oxide-*` headers."
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "408": {
            "$ref": "#/components/responses/UploadTimeout"
          },
          "413": {
            "$ref": "#/components/responses/TooLarge"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          },
          "429": {
            "$ref": "#/components/responses/Busy"
          },
          "503": {
            "$ref": "#/components/responses/Draining"
          }
        }
      }
    },
    "/v1/info": {
      "post": {
        "tags": [
          "extract"
        ],
        "operationId": "documentInfo",
        "summary": "Document format, metadata and structure",
        "description": "Office and OpenDocument: format, core metadata, and structure (sheet names and\ndimensions, slide count, section count). PDF: metadata, page count, encryption flag and\nper-page geometry. Images: page count and pixel dimensions, read from the headers only.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/format"
          },
          {
            "$ref": "#/components/parameters/filename"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/Document"
        },
        "responses": {
          "200": {
            "description": "Document info",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/PdfInfo"
                    },
                    {
                      "$ref": "#/components/schemas/OfficeInfo"
                    },
                    {
                      "$ref": "#/components/schemas/ImageInfo"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "kind",
                    "mapping": {
                      "pdf": "#/components/schemas/PdfInfo",
                      "office": "#/components/schemas/OfficeInfo",
                      "image": "#/components/schemas/ImageInfo"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "408": {
            "$ref": "#/components/responses/UploadTimeout"
          },
          "413": {
            "$ref": "#/components/responses/TooLarge"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          },
          "429": {
            "$ref": "#/components/responses/Busy"
          },
          "503": {
            "$ref": "#/components/responses/Draining"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "ops"
        ],
        "operationId": "healthz",
        "summary": "Liveness",
        "description": "Fails (503) only when the watchdog sees a job running longer than 10x its deadline.",
        "security": [],
        "responses": {
          "200": {
            "description": "Alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "503": {
            "description": "Unhealthy; restart the container",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "ops"
        ],
        "operationId": "readyz",
        "summary": "Readiness",
        "description": "Ready once startup (including OCR model loading and golden smoke tests) is done; 503 while starting or draining.",
        "security": [],
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "503": {
            "description": "Not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/version": {
      "get": {
        "tags": [
          "ops"
        ],
        "operationId": "version",
        "summary": "Build, engine versions, limits and OCR status",
        "security": [],
        "responses": {
          "200": {
            "description": "Version info",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Version"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "ops"
        ],
        "operationId": "metrics",
        "summary": "Prometheus metrics",
        "security": [],
        "responses": {
          "200": {
            "description": "Prometheus text exposition",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": [
          "ops"
        ],
        "operationId": "openapiJson",
        "summary": "This contract as JSON",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.yaml": {
      "get": {
        "tags": [
          "ops"
        ],
        "operationId": "openapiYaml",
        "summary": "This contract as YAML",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI document",
            "content": {
              "application/yaml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/docs": {
      "get": {
        "tags": [
          "ops"
        ],
        "operationId": "docs",
        "summary": "Interactive API reference (Scalar, loaded from a CDN)",
        "security": [],
        "responses": {
          "200": {
            "description": "HTML page",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "The value of `OXIDE_API_API_KEY`."
      }
    },
    "parameters": {
      "format": {
        "name": "format",
        "in": "query",
        "required": false,
        "description": "Format hint, used only when the content itself is inconclusive (the content sniff always\nwins). Aliases are accepted too: template and macro-enabled extensions (`dotx`, `xlsm`,\n`ott`, ...), `jpg`, `tif`, `pbm`/`pgm`/`ppm`, `j2k`. TGA has no signature, so a TGA needs\nthis hint or a `.tga` filename.\n",
        "schema": {
          "type": "string",
          "enum": [
            "pdf",
            "docx",
            "xlsx",
            "pptx",
            "doc",
            "xls",
            "ppt",
            "odt",
            "ods",
            "odp",
            "png",
            "jpeg",
            "tiff",
            "webp",
            "gif",
            "bmp",
            "jp2",
            "pnm",
            "tga"
          ]
        }
      },
      "pages": {
        "name": "pages",
        "in": "query",
        "required": false,
        "description": "PDF and images (TIFF pages). 1-based pages and ranges, e.g. `1-3,5`.",
        "schema": {
          "type": "string",
          "example": "1-3,5"
        }
      },
      "ocr": {
        "name": "ocr",
        "in": "query",
        "required": false,
        "description": "PDF and images. PDF: `auto` OCRs pages classified as scanned, hybrid or set in a legacy\nHindi font; `force` OCRs every requested page; `off` skips classification. Images are\nalways OCR'd unless `off`.\n",
        "schema": {
          "type": "string",
          "enum": [
            "auto",
            "force",
            "off"
          ],
          "default": "auto"
        }
      },
      "lang": {
        "name": "lang",
        "in": "query",
        "required": false,
        "description": "PDF and images. OCR language. `auto` resolves once per document: legacy Hindi font →\n`hi`; else the native text's script; else a confidence probe on the first OCR page; else\n`en`.\n",
        "schema": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "hi",
            "ar"
          ],
          "default": "auto"
        }
      },
      "detect_headings": {
        "name": "detect_headings",
        "in": "query",
        "required": false,
        "description": "PDF markdown only. Detect headings from font size and weight.",
        "schema": {
          "type": "boolean",
          "default": true
        }
      },
      "clean": {
        "name": "clean",
        "in": "query",
        "required": false,
        "description": "Any document. When `true`, extra whitespace is collapsed: runs of spaces and tabs\nbecome a single space, trailing whitespace on each line is removed, 3+ newlines\nbecome a single blank line, and leading/trailing blank lines are trimmed.\nMarkdown code-block indentation is collapsed to a single space.\n",
        "schema": {
          "type": "boolean",
          "default": false
        }
      },
      "filename": {
        "name": "filename",
        "in": "query",
        "required": false,
        "description": "Original filename; its extension is the last-resort format hint (after the content and `format`).",
        "schema": {
          "type": "string"
        }
      }
    },
    "requestBodies": {
      "Document": {
        "required": true,
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "required": [
                "file"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "format": "binary",
                  "description": "The document."
                },
                "format": {
                  "type": "string"
                },
                "pages": {
                  "type": "string"
                },
                "ocr": {
                  "type": "string"
                },
                "lang": {
                  "type": "string"
                },
                "detect_headings": {
                  "type": "string"
                },
                "clean": {
                  "type": "string"
                }
              }
            }
          },
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "file_base64"
              ],
              "properties": {
                "file_base64": {
                  "type": "string",
                  "description": "Base64 (standard or URL-safe; a `data:` URI prefix is accepted)."
                },
                "format": {
                  "type": "string"
                },
                "pages": {
                  "type": "string"
                },
                "ocr": {
                  "type": "string"
                },
                "lang": {
                  "type": "string"
                },
                "detect_headings": {
                  "type": "boolean"
                },
                "clean": {
                  "type": "boolean"
                },
                "filename": {
                  "type": "string"
                }
              },
              "additionalProperties": {
                "description": "Parameters are top-level scalars, never nested."
              }
            }
          },
          "application/octet-stream": {
            "schema": {
              "type": "string",
              "format": "binary"
            },
            "description": "Any other content type is treated as the raw document."
          }
        }
      }
    },
    "headers": {
      "X-Engine": {
        "description": "Engine and version: `pdf_oxide/0.3.78` (PDFs, and image OCR), `office_oxide/0.1.13`\n(DOCX/XLSX/PPTX/DOC/XLS/PPT) or `oxide-api/0.2.0` (OpenDocument, image info).\n",
        "schema": {
          "type": "string"
        }
      },
      "Server-Timing": {
        "description": "`queue`, `parse`, `extract` and (when OCR ran) `ocr` durations in ms.",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Malformed input or an invalid parameter (the problem names the accepted values).",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or wrong bearer token.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "UploadTimeout": {
        "description": "The request body took longer than 30 s to arrive.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "TooLarge": {
        "description": "The request body is over the 32 MiB limit.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unprocessable": {
        "description": "Unsupported, corrupt or encrypted document (`encrypted-document`, `corrupt-document`,\n`unsupported-format`, `too-many-pages`, `image-too-large`), a processing timeout\n(`processing-timeout`), or every page's OCR failing with `ocr=force` or on an image\n(`ocr-failed`).\n",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Busy": {
        "description": "No processing slot became free within 1 s. Honour `Retry-After`.",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Draining": {
        "description": "The instance is shutting down.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "FormatSource": {
        "type": "string",
        "enum": [
          "sniff",
          "param",
          "filename"
        ],
        "description": "How the format was determined."
      },
      "PdfExtraction": {
        "type": "object",
        "required": [
          "kind",
          "format",
          "format_source",
          "text",
          "char_count",
          "truncated",
          "page_count",
          "pages_extracted",
          "incomplete",
          "ocr"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "const": "pdf"
          },
          "format": {
            "type": "string",
            "const": "pdf"
          },
          "format_source": {
            "$ref": "#/components/schemas/FormatSource"
          },
          "text": {
            "type": "string"
          },
          "char_count": {
            "type": "integer",
            "description": "Unicode scalar values in `text`."
          },
          "truncated": {
            "type": "boolean",
            "description": "The 4 Mi-character output budget ran out."
          },
          "page_count": {
            "type": "integer"
          },
          "pages_extracted": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "1-based pages whose text is in `text`."
          },
          "incomplete": {
            "type": "boolean",
            "description": "The deadline passed; request the missing pages with `pages=`."
          },
          "ocr": {
            "$ref": "#/components/schemas/OcrInfo"
          },
          "failed_pages": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Pages whose native text could not be extracted (omitted when empty)."
          },
          "ignored_params": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Parameters that don't apply to this document (omitted when empty)."
          }
        }
      },
      "OcrInfo": {
        "type": "object",
        "required": [
          "status",
          "pages",
          "pages_needing_ocr",
          "failed_pages"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "native",
              "ocr",
              "hybrid",
              "unavailable",
              "off"
            ],
            "description": "`native`: no page needed OCR. `ocr`: every page came from OCR. `hybrid`: a mix, or\nnative text plus OCR lines. `unavailable`: OCR was needed but isn't available here\n(models not loaded, or the language isn't available). `off`: `ocr=off`.\n"
          },
          "lang": {
            "type": "string",
            "enum": [
              "en",
              "hi",
              "ar"
            ]
          },
          "lang_source": {
            "type": "string",
            "enum": [
              "param",
              "font",
              "text",
              "probe",
              "default"
            ]
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Pages whose output includes OCR text."
          },
          "pages_needing_ocr": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Pages that need OCR but didn't get it (OCR unavailable for them)."
          },
          "failed_pages": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Pages whose OCR failed; they carry native text, or none when the page's OCR layer was junk."
          },
          "reasons": {
            "type": "array",
            "description": "Why each page was routed to OCR (omitted when none was).",
            "items": {
              "type": "object",
              "required": [
                "page",
                "reason"
              ],
              "properties": {
                "page": {
                  "type": "integer"
                },
                "reason": {
                  "type": "string",
                  "enum": [
                    "scanned",
                    "hybrid",
                    "legacy_font",
                    "forced",
                    "image"
                  ]
                }
              }
            }
          }
        }
      },
