{{CADDY_DOMAIN}} {
	encode zstd gzip

	# Uploads up to the app's 32 MiB limit (OXIDE_API_MAX_BODY_BYTES). Caddy's
	# cap sits above it so the app answers oversize bodies itself with a
	# problem+json 413.
	request_body {
		max_size 40MB
	}

	# Prometheus metrics stay on the docker network (oxide-api:8080/metrics).
	@metrics path /metrics
	respond @metrics 404

	reverse_proxy oxide-api:8080 {
		# OCR requests answer by their 90 s deadline (OXIDE_API_OCR_TIMEOUT_SECS).
		transport http {
			dial_timeout 10s
			response_header_timeout 120s
		}
	}

	log {
		output stdout
		format console
	}
}
