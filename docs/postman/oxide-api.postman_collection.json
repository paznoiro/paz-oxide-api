        {
          "name": "POST /v1/info — spreadsheet (ODS)",
          "request": {
            "description": "Metadata from `meta.xml` plus sheet names and dimensions (rows and columns that hold text).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{apiKey}}",
                  "type": "string"
                }
