            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/extract/markdown",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "extract", "markdown"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "An ODT, ODS or ODP file.",
                  "src": "tests/fixtures/sample.odt"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
