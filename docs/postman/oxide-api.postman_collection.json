    {
      "name": "opendocument",
      "description": "ODT, ODS and ODP (and their templates OTT/OTS/OTP), as saved by LibreOffice, Collabora or Google Docs. Same response shape as Office documents: `kind: office`, `format: odt|ods|odp`; `X-Engine` is `oxide-api/<version>`. Markdown has headings, lists and tables, one `## <sheet>` table per sheet and one section per slide with speaker notes. Comments, tracked deletions and headers/footers are left out. A password-protected file is a `422 encrypted-document`.\n\nThe file sources point at the repo's test fixtures: set Postman's working directory to the repo root (Settings → General → Working directory) to send them as-is, or pick your own file.",
      "item": [
        {
          "name": "POST /v1/extract/markdown — ODT / ODS / ODP (multipart)",
          "request": {
            "description": "Markdown from an OpenDocument file. The fixture is a text document with a heading and a table; swap in `sample.ods` or `sample.odp` for a spreadsheet or a presentation.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{apiKey}}",
                  "type": "string"
                }
