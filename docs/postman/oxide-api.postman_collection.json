                  "description": "Only needed for a TGA uploaded without a .tga filename."
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200, image OCR'd\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var j = pm.response.json();",
                  "    pm.expect(j.kind).to.eql(\"image\");",
                  "    pm.expect(j.ocr.status).to.be.oneOf([\"ocr\", \"off\", \"unavailable\"]);",
